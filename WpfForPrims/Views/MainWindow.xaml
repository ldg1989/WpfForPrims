<Window x:Class="WpfForPrims.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfForPrims.Views"
        mc:Ignorable="d"
          xmlns:prism="http://prismlibrary.com/"
  prism:ViewModelLocator.AutoWireViewModel="True"
        Title="XXXXXXXXXXX" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="80"></Setter>
                    <Setter Property="Height" Value="30"></Setter>
                </Style>
            </StackPanel.Resources>

            <Button Content="模块A" Command="{Binding ShowContentCmm}" CommandParameter="UCA"></Button>
            <Button Content="模块B" Command="{Binding ShowContentCmm}" CommandParameter="UCB"></Button>
            <Button Content="模块C" Command="{Binding ShowContentCmm}" CommandParameter="UCC"></Button>

        </StackPanel>
        <ContentControl Grid.Row="1" prism:RegionManager.RegionName="ContentRegion"></ContentControl>


    </Grid>
</Window>
